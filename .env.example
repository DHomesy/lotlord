# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/dbname

# In production: set to 'false' ONLY if your DB provider uses a self-signed cert that
# your runtime does not trust (e.g. some Railway internal hostnames). Leave unset or
# set to 'true' (the default) for all standard deployments.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional — paste the full PEM certificate from your DB provider when using a
# custom CA bundle (uncommon; only needed if REJECT_UNAUTHORIZED stays true but
# the cert chain is not in the system trust store).
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...

# Auth
# Generate both secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
# Separate secret for refresh tokens. If unset, falls back to JWT_SECRET + '_refresh'.
# Setting a truly independent value means a compromised access-token secret cannot be
# used to forge refresh tokens (and vice-versa). Strongly recommended in production.
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_EXPIRES_IN=15m           # access token lifetime  (short — stored in memory on client)
JWT_REFRESH_EXPIRES_IN=30d   # refresh token lifetime (long  — httpOnly cookie only)
COOKIE_SAME_SITE=lax         # set to 'none' when frontend and API are on different sites/domains
COOKIE_SECURE=               # optional true/false override; auto-forced true when COOKIE_SAME_SITE=none

# Frontend
# Used for CORS allowed-origin. Comma-separate multiple origins in production.
FRONTEND_URL=http://localhost:5173

# AWS SES — email sending + inbound processing
# IAM credentials are output by the CDK stack (cdk deploy) as ApiSesAccessKeyId / ApiSesSecretAccessKey
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sender addresses — must match verified SES domain (lotlord.app)
SES_FROM_ADDRESS=noreply@lotlord.app
SES_REPLY_TO_ADDRESS=reply@lotlord.app

# SES configuration set — routes bounce/complaint events to SNS (created by CDK)
SES_CONFIGURATION_SET=lotlord-config-set

# Shared secret — Lambda authenticates to POST /api/v1/webhooks/ses with this header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the webhookSecret passed to `cdk deploy --context webhookSecret=<value>`
SES_WEBHOOK_SECRET=

# AWS S3 — file storage (documents + maintenance attachments)
S3_BUCKET_NAME=lotlord-files

# AWS SMS
# Origination identity can be a phone number, sender ID, or pool ARN depending on your setup.
AWS_SMS_ORIGINATION_IDENTITY=
# TRANSACTIONAL or PROMOTIONAL
AWS_SMS_MESSAGE_TYPE=TRANSACTIONAL
# Optional AWS SMS configuration set for delivery analytics/event routing
AWS_SMS_CONFIGURATION_SET_NAME=
# TOLL_FREE, TEN_DLC, or SHORT_CODE depending on your AWS account setup
AWS_SMS_NUMBER_TYPE=TOLL_FREE
# Optional two-way routing channel (SNS topic ARN + role ARN)
# If both are set, newly provisioned dedicated numbers are auto-wired to inbound webhook delivery.
AWS_SMS_TWO_WAY_CHANNEL_ARN=
AWS_SMS_TWO_WAY_CHANNEL_ROLE_ARN=
# Shared secret for POST /api/v1/webhooks/aws/sms (x-webhook-secret header)
AWS_SMS_WEBHOOK_SECRET=
# Optional keyword auto-response copy configured during provisioning
SMS_HELP_RESPONSE=
SMS_STOP_CONFIRMATION=
SMS_START_CONFIRMATION=
# Delivery retry policy
SMS_SEND_MAX_ATTEMPTS=3
# Monthly segment caps used to switch AI into approval mode when exceeded
SMS_CAP_AUTOPILOT=1000
SMS_CAP_PORTFOLIO=2500
# AI message segment warning/block thresholds (single outbound message)
SMS_AI_WARN_SEGMENTS=3
SMS_AI_BLOCK_SEGMENTS=6

# Public URL of this server
# Use your Railway/production URL in production; set to your ngrok URL for local testing
APP_BASE_URL=https://your-app.railway.app

# Stripe
# Use sk_live_... in production. NEVER commit a live key — set via Railway environment variable.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — copy from Stripe Dashboard → Developers → Webhooks → <your endpoint> → Signing secret
# ⚠  Test and live endpoints each have a DIFFERENT secret. Make sure you copy the live secret for production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Plan Price IDs — create in Stripe Dashboard → Products (monthly billing for paid tiers).
# Set price nicknames in Stripe to: autopilot | portfolio
# The webhook handler reads the nickname to store the correct plan label.
STRIPE_PRICE_ID_AUTOPILOT=price_...
STRIPE_PRICE_ID_PORTFOLIO=price_...

# OpenAI
OPENAI_API_KEY=sk-...

# Error alerting — SES email sent on any 5xx or unhandled rejection (production only)
ALERT_EMAIL=

# --- Future / Uncomment when scaling ---
# REDIS_URL=redis://localhost:6379
