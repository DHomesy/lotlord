# Only needed for PRODUCTION builds.
# In development, Vite proxies /api automatically to localhost:3000.
# VITE_API_URL=https://your-api.railway.app

# Required for embedded subscription checkout, tenant bank setup, and Connect components.
# Use pk_test_... in test and pk_live_... in production. It must belong to the same
# Stripe account and mode as the backend STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
